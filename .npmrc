# Scopes @at and @af live in the Azure Artifacts feed. No credentials here: they go in each developer's
# user-level ~/.npmrc (or are injected by the pipeline with npmAuthenticate).
@at:registry=https://pkgs.dev.azure.com/ApoyosTecnologicos/_packaging/ApoyosTecnologicos/npm/registry/
@af:registry=https://pkgs.dev.azure.com/ApoyosTecnologicos/_packaging/ApoyosTecnologicos/npm/registry/
